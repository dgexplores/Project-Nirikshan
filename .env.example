# --- Core ---
# SQLite by default; for Postgres use:
#   postgresql+psycopg://bdd:bdd_local_only@localhost:5432/bdd
BDD_DATABASE_URL=sqlite:///data/bdd.db
BDD_RAW_STORE=data/raw
BDD_MANIFEST_DIR=data/manifests
BDD_FIXTURES_DIR=data/fixtures/public

# --- Server ---
BDD_CORS_ORIGINS=http://localhost:3000
BDD_MAX_UPLOAD_MB=200

# --- Ask Detective LLM synthesis (optional) ---
# Any OpenAI-compatible /chat/completions endpoint. Leave empty to run the
# deterministic cited-synthesis mode.
BDD_LLM_BASE_URL=
BDD_LLM_API_KEY=
# Example: BDD_LLM_BASE_URL=https://api.openai.com/v1  BDD_LLM_MODEL=gpt-4o-mini
BDD_LLM_MODEL=

# --- Jobs ---
BDD_JOB_WORKERS=2

# --- Optional hardening (all default to current open behavior when unset) ---
# Require X-API-Key header on all routes except /health, /health/ready, /docs.
BDD_API_KEY=
# Future vector-retrieval endpoint for Ask Detective (TF-IDF fallback stays default).
BDD_QDRANT_URL=
